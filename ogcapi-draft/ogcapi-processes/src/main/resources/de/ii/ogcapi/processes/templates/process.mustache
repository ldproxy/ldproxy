{{> header}}

<div>
  <h1>{{title}}</h1>

  {{#process}}
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">{{idTitle}}</div>
      <div class="col-md-8">{{id}}</div>
    </div>
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">{{descriptionTitle}}</div>
      <div class="col-md-8">{{#description}}{{{.}}}{{/description}}{{^description}}{{none}}{{/description}}</div>
    </div>
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">Version</div>
      <div class="col-md-8">{{version}}</div>
    </div>
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">{{jobControlOptionsTitle}}</div>
      <div class="col-md-8">
        <ul class="list-unstyled mb-0">
          {{#jobControlOptions}}
            <li>{{.}}</li>
          {{/jobControlOptions}}
          {{^jobControlOptions}}
            <li>{{none}}</li>
          {{/jobControlOptions}}
        </ul>
      </div>
    </div>
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">{{keywordsTitle}}</div>
      <div class="col-md-8">
        <ul class="list-unstyled mb-0">
          {{#keywords}}
            <li>{{.}}</li>
          {{/keywords}}
          {{^keywords}}
            <li>{{none}}</li>
          {{/keywords}}
        </ul>
      </div>
    </div>
    <div class="row my-1">
      <div class="col-md-4 font-weight-bold text-truncate">{{metadataTitle}}</div>
      <div class="col-md-8">
        <ul class="list-unstyled mb-0">
          {{#metadata}}
            <li>{{#title}}{{.}}{{/title}}{{#role}} ({{.}}){{/role}}{{#lang}} [{{.}}]{{/lang}}</li>
          {{/metadata}}
          {{^metadata}}
            <li>{{none}}</li>
          {{/metadata}}
        </ul>
      </div>
    </div>
  {{/process}}

  <h3 class="mt-4">{{inputsTitle}}</h3>
  {{#inputs}}
    <div class="mb-3">
      <h4 class="mt-3 mb-1">{{title}}</h4>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{idTitle}}</div>
        <div class="col-md-8">{{id}}</div>
      </div>
      {{#description}}
        <div class="row my-1">
          <div class="col-md-4 font-weight-bold text-truncate">{{descriptionTitle}}</div>
          <div class="col-md-8">{{.}}</div>
        </div>
      {{/description}}
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{schemaTitle}}</div>
        <div class="col-md-8">{{schema}}</div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{occurrencesTitle}}</div>
        <div class="col-md-8">{{occurrences}}</div>
      </div>
    </div>
  {{/inputs}}
  {{^inputs}}
    <p>{{none}}</p>
  {{/inputs}}

  <h3 class="mt-4">{{outputsTitle}}</h3>
  {{#outputs}}
    <div class="mb-3">
      <h4 class="mt-3 mb-1">{{title}}</h4>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{idTitle}}</div>
        <div class="col-md-8">{{id}}</div>
      </div>
      {{#description}}
        <div class="row my-1">
          <div class="col-md-4 font-weight-bold text-truncate">{{descriptionTitle}}</div>
          <div class="col-md-8">{{.}}</div>
        </div>
      {{/description}}
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{schemaTitle}}</div>
        <div class="col-md-8">{{schema}}</div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{occurrencesTitle}}</div>
        <div class="col-md-8">{{occurrences}}</div>
      </div>
    </div>
  {{/outputs}}
  {{^outputs}}
    <p>{{none}}</p>
  {{/outputs}}

</div>

{{> footer}}
