{{> header}}

<div>
  <h1>{{title}}</h1>
  <span>{{{description}}}</span>
  <br/>
  <br/>

  {{> pagination}}

  {{#processList}}
    <div class="mb-4">
      <h4 class="mt-3 mb-1"><a href="processes/{{id}}">{{#title}}{{.}}{{/title}}{{^title}}{{id}}{{/title}}</a></h4>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{idTitle}}</div>
        <div class="col-md-8">{{id}}</div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{descriptionTitle}}</div>
        <div class="col-md-8">{{#description}}{{.}}{{/description}}{{^description}}{{none}}{{/description}}</div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">Version</div>
        <div class="col-md-8">{{version}}</div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{jobControlOptionsTitle}}</div>
        <div class="col-md-8">
          <ul class="list-unstyled mb-0">
            {{#jobControlOptions}}
              <li>{{.}}</li>
            {{/jobControlOptions}}
            {{^jobControlOptions}}
              <li>{{none}}</li>
            {{/jobControlOptions}}
          </ul>
        </div>
      </div>
      <div class="row my-1">
        <div class="col-md-4 font-weight-bold text-truncate">{{keywordsTitle}}</div>
        <div class="col-md-8">
          <ul class="list-unstyled mb-0">
            {{#keywords}}
              <li>{{.}}</li>
            {{/keywords}}
            {{^keywords}}
              <li>{{none}}</li>
            {{/keywords}}
          </ul>
        </div>
      </div>
    </div>
  {{/processList}}
  {{^processList}}
    <p>{{none}}</p>
  {{/processList}}

  {{> pagination}}

</div>

{{> footer}}
